<div class="b-example-divider b-example-vr"></div>

<!-- Modal -->
<form class="modal fade" action="/update-profile" method="post" enctype="multipart/form-data" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">Change Profile Image</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="px-4 modal-body d-flex justify-content-between align-items-center">
        <label for="inputFile" class="btn btn-secondary">
          <i class="bi bi-plus"></i>
          Upload Img
        </label>
        <input type="file" name="avatar" style="display: none;" id="inputFile" required>
        <img id="profileImage" style="border-radius: 50%;" src="<%= user.profileImage ? user.profileImage : '../img/avatar.png'%>" alt="" width="150" height="150">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </div>
  </div>
</form>
<script>
  inputFile.addEventListener("change", (eo) => {
    profileImage.src = URL.createObjectURL(eo.target.files[0]);
  });
</script>